# Groq API Keys (comma-separated for multiple keys / rotation)
GROQ_KEYS=gsk_xxx1,gsk_xxx2,gsk_xxx3

# Groq AI Model
GROQ_MODEL=llama-3.1-8b-instant

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-settings

# Frontend URL(s) allowed by CORS (comma-separated for multiple domains)
# To add a new frontend domain, append it here. No code changes needed.
FRONTEND_URL=https://eva-me.vercel.app,https://eva-ai.vercel.app

# Rate Limiting (requests per window)
RATE_LIMIT=30
RATE_LIMIT_WINDOW=60

# Message Limits
MAX_MESSAGE_LENGTH=4096
MAX_HISTORY=1000

# Key Rotation
KEY_RETRY_LIMIT=3
KEY_COOLDOWN_SECONDS=300

# Server
PORT=10000
ENV=production
LOG_LEVEL=INFO
